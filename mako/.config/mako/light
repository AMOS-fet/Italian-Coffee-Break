# -----------------------------------------------------
# File: light
# Description: Mako configuration file (Gruvbox Light Theme)
# Author: Amos
# -----------------------------------------------------

# -----------------------------------------------------
# 1. GENERAL & POSITIONING
# -----------------------------------------------------
sort=-time
layer=overlay
anchor=top-right
max-visible=5

width=350
height=150
margin=10
padding=15

# -----------------------------------------------------
# 2. APPEARANCE (GRUVBOX LIGHT)
# -----------------------------------------------------
font=SF Pro Display 9
background-color=#F9EDD2
text-color=#282828

# Border styling (Rust Orange for contrast)
border-size=4
## BORDER_ANCHOR
border-radius=10

# Icons
icons=1
max-icon-size=48
icon-location=left

# -----------------------------------------------------
# 3. BEHAVIOR
# -----------------------------------------------------
markup=1
actions=1
history=1
max-history=50

# Timeouts (in milliseconds)
default-timeout=5000
ignore-timeout=1

# -----------------------------------------------------
# 4. INPUT BINDINGS
# -----------------------------------------------------
on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss

# -----------------------------------------------------
# 5. URGENCY LEVELS
# -----------------------------------------------------

[urgency=low]
border-color=#98971C
text-color=#98971C
default-timeout=3000

[urgency=high]
border-color=#CA2420
text-color=#CA2420
default-timeout=0

# -----------------------------------------------------
# 6. APP SPECIFIC RULES
# -----------------------------------------------------

[category=screenshot]
border-color=#448385

[app-name=Spotify]
border-color=#98971C

# -----------------------------------------------------
# 7. MODES
# -----------------------------------------------------

[mode=dnd]
invisible=1
